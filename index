<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>@aza</title>
<style>
  :root{
    --bg:#ffffff;
    --line:#dbdbdb;
    --ink:#262626;
    --muted:#8e8e8e;
  }
  *{ margin:0; 
    padding:0; 
    box-sizing:border-box; }
  body{ 
    font-family:'Poppins', sans-serif; 
    background:var(--bg); 
    color:var(--ink); 
    display: flex;
  }
  .sidebar{
    width:247px;
    flex-shrink:0;
    min-height:100vh;
    user-select:none;
  }
  .sidebar-img{
    width:100%;
    display:block;
    pointer-events:none;
  }
  .wrap{ 
    flex: 1;
    max-width:600px; 
    margin:0 auto; 
    padding:16px; 
  }

  .header{ 
    display:flex; 
    align-items:center; 
    gap:20px; 
    padding:16px 0; 
  }
  .avaphoto{
    width:86px; 
    height:86px; 
    border-radius:50%; 
    flex-shrink:0;
    object-fit: cover;
  }
  .info h1{ 
    font-size:20px; 
    font-weight:600; 
    margin-bottom:6px; 
  }
  .stats{ 
    display:flex; 
    gap:20px; 
    margin:10px 0; 
    font-size:14px; 
  }
  .stats b{ 
    display:block; 
    font-size:16px; 
  }
  .bio{ 
    font-size:14px; 
    color:var(--muted); 
    line-height:1.5; 
  }
  .tabs{ 
    display:flex; 
    border-top:1px solid var(--line); 
    margin-top:16px; 
  }
  .tabs div{ 
    flex:1; 
    text-align:center; 
    padding:12px 0; 
    font-size:12px; 
    letter-spacing:1px; 
    color:var(--ink); 
    border-top:1px solid var(--ink); 
    margin-top:-1px; 
  }
  .grid{ 
    display:grid; 
    grid-template-columns:1fr 1fr 1fr; 
    gap:3px; 
  }
  .rot {
    display: none;
  }
  .grid label {
    display: block;
    width: 100%;
    cursor: pointer;
  }
  .tile {
    width: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }
  .rot:checked + label .tile {
  transform: scaleX(-1);
  }
</style>
</head>
<body>
<div class="sidebar">
  <img class="sidebar-img" src="https://i.ibb.co.com/LznvZfKN/b168ff3d-6db6-46ab-8432-6cd8797f168c.png" alt="меню">
</div>
<div class="wrap">
  <div class="header">
    <img class="avaphoto" src="https://i.ibb.co.com/4wNM9Qrg/5267395373137861867.jpg" alt="Жамбыл Азамат">
    <div class="info">
      <h1>azamat</h1>
      <div class="stats">
        <div><b>6</b>публикации</div>
        <div><b>1,204</b>подписчики</div>
        <div><b>356</b>подписки</div>
      </div>
    </div>
  </div>
  <div class="bio">✨ моя личная страница<br>📍 Алматы</div>
  <div class="tabs"><div>▦ ПУБЛИКАЦИИ</div></div>

  <div class="grid">
    <input type="checkbox" id="r1" class="rot">
    <label for="r1">
      <img class="tile" src="https://i.ibb.co.com/dsxjpsdx/5289891600085491169.jpg">
    </label>
    <input type="checkbox" id="r2" class="rot">
    <label for="r2">
      <img class="tile" src="https://i.ibb.co.com/HLN7nGNG/5289891600085491174.jpg">
    </label>
    <input type="checkbox" id="r3" class="rot">
    <label for="r3">
      <img class="tile" src="https://i.ibb.co.com/TMJfssP9/5289891600085491173.jpg">
    </label>
    <input type="checkbox" id="r4" class="rot">
    <label for="r4">
      <img class="tile" src="https://i.ibb.co.com/Xk51MhGF/5289891600085491171.jpg">
    </label>
    <input type="checkbox" id="r5" class="rot">
    <label for="r5">
      <img class="tile" src="https://i.ibb.co.com/LD1KW251/5289891600085491172.jpg">
    </label>
    <input type="checkbox" id="r6" class="rot">
    <label for="r6">
      <img class="tile" src="https://i.ibb.co.com/ynpgYQKy/5289891600085491170.jpg">
    </label>
    <input type="checkbox" id="r7" class="rot">
    <label for="r7">
      <img class="tile" src="https://i.ibb.co.com/TqpWpNWr/5289891600085491168.jpg">
    </label>
    <input type="checkbox" id="r8" class="rot">
    <label for="r8">
      <img class="tile" src="https://i.ibb.co.com/SXmTc1km/5289891600085491175.jpg">
    </label>
    <input type="checkbox" id="r9" class="rot">
    <label for="r9">
      <img class="tile" src="https://i.ibb.co.com/3yWv4yXN/5289891600085491167.jpg">
    </label>
  </div>
</div>

</body>
</html>
